# Copy to mobile/.env and fill in. Metro inlines anything prefixed EXPO_PUBLIC_
# at bundle time, so these end up INSIDE the APK - treat every value here as
# public and never put a server-side secret in this file.

# Where the API lives, including the /api/v1 suffix.
#
# Unset, src/config.js falls back to a development machine's LAN address, which
# is useful at a desk and useless anywhere else. A physical phone cannot reach
# `localhost`, so in development this is your PC's IPv4 address (`ipconfig`)
# with the phone on the same Wi-Fi. For a real build it is the deployed host.
#
# THE APK MUST BE REBUILT AFTER CHANGING THIS. The value is compiled into the
# bundle, not read at runtime, so an installed app keeps whatever it was built
# with no matter what this file says later.
EXPO_PUBLIC_API_URL="http://192.168.1.10:5000/api/v1"

# MapTiler Cloud key for the map tiles.
#
# Requested by the DEVICE, not by the API, so it is public by nature; the
# protection is the allowed-origin list on the key itself. Note that the key
# used in development is restricted to http://localhost:5173, which a phone is
# not - the map will be refused until the app's origin is added to the key.
# Without this set, MapPicker renders "Map unavailable" and report filing still
# works, because the location is optional.
EXPO_PUBLIC_MAPTILER_API_KEY="your_maptiler_api_key"
