{
  "expo": {
    "name": "CENROWATCH",
    "slug": "cenrowatch",
    "scheme": "cenrowatch",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/233a9c36-8f62-4bcc-9e03-409f3f08f643"
    },
    "orientation": "portrait",
    "icon": "./assets/cenro-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.aishiii.cenrowatch"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CENROWATCH needs access to your photos so you can attach evidence to a report.",
          "cameraPermission": "CENROWATCH needs camera access so you can photograph an environmental concern."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CENROWATCH uses your location to pin where an environmental report was made."
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "233a9c36-8f62-4bcc-9e03-409f3f08f643"
      }
    }
  }
}
