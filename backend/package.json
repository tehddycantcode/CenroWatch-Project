{
  "name": "cenrowatch-backend",
  "version": "0.1.0",
  "description": "CENROWATCH API — Express + Prisma + MySQL backend for CENRO Cabuyao",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:docker": "prisma migrate deploy && node prisma/seed.js && node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "create-admin": "node prisma/create-admin.js",
    "check-mail": "node scripts/check-mail.js",
    "test": "jest",
    "backfill-sla": "node scripts/backfill-sla-start.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "keywords": [
    "cenrowatch",
    "cabuyao",
    "environmental",
    "express",
    "prisma"
  ],
  "author": "Moro, Quizana, Zaspa — Pamantasan ng Cabuyao BSIT",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
