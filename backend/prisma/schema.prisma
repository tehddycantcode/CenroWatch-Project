// CENROWATCH — Prisma schema
// Derived from the system ERD (Part 4) + Citizens Charter / SLA fields (Part 20).
// Provider: MySQL. All app DB access goes through Prisma (no raw SQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  Admin
  CENRO_Staff
  Resident
}

// Approved is the acknowledgement gate: the SLA clock starts there, not at
// submission. Placed in workflow order rather than appended, so the enum reads
// as the process it describes. Under_Review is triage BEFORE acceptance; a
// complaint sitting there has no deadline yet.
enum ComplaintStatus {
  Pending
  Under_Review
  Approved
  In_Progress
  Resolved
  Rejected
}

// ComplaintType and RequestType used to be enums here. They are now tables
// (below) so an Admin can add or retire a category from the UI without a schema
// change and a redeploy.
//
// The report column stays a VARCHAR holding the type NAME, with a foreign key to
// that name rather than to a surrogate id. That is deliberate: the name is what
// every groupBy, PDF row, badge and humanize() call in the system already reads,
// and switching to an id would have meant rewriting 134 call sites across 37
// files for no gain in integrity. The FK gives the same guarantee either way.


enum RequestStatus {
  Pending
  Approved
  Scheduled
  Completed
  Rejected
}

enum WildlifeStatus {
  Pending_Review
  Priority_Review
  Under_Care
  Released
  Transferred
  Deceased
}

enum AnimalCondition {
  Healthy
  Injured
  Sick
  Dead
}

// Citizens Charter — receipt channels & responsible roles (Part 20)
enum ComplaintReceivedVia {
  Walk_In
  Email
  Phone_Call
  Facebook_Messenger
  Logbook_Record
}

enum WildlifeReportedVia {
  Walk_In
  Phone_Call
  Social_Media
}

enum CenroPersonRole {
  CENRO_Head
  Administrative_Staff
  Environmental_Management_Specialist
  Environmental_Inspector
  Wildlife_Enforcer_Officer
  Technical_Enforcement_Division_Personnel
}

// ============================================================
// USERS
// ============================================================

model User {
  user_id         Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  password_hash   String    @db.VarChar(255)
  first_name      String    @db.VarChar(100)
  last_name       String    @db.VarChar(100)
  contact_number  String?   @db.VarChar(255) // encrypted at rest (AES-256-GCM); sized for the envelope, not the number
  role            Role      @default(Resident)
  barangay_id     Int?
  is_active       Boolean   @default(true)
  privacy_consent Boolean   @default(false)
  consent_date    DateTime?
  email_verified_at DateTime?
  // When this account's password last changed. A JWT issued before this instant
  // is refused by authenticate(), which is what makes "change my password"
  // actually end the sessions on other devices - a stateless JWT is otherwise
  // valid for its full JWT_EXPIRES_IN no matter what happens to the password.
  // Null means "never changed since the column was added", which cannot
  // invalidate anything, so existing sessions survive the migration.
  password_changed_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  barangay            Barangay?              @relation(fields: [barangay_id], references: [barangay_id])
  complaints          Complaint[]            @relation("UserComplaints")
  assigned_complaints Complaint[]            @relation("AssignedStaff")
  logged_complaints   Complaint[]            @relation("LoggedByStaff")
  wildlife_turnovers  WildlifeTurnover[]     @relation("UserWildlife")
  processed_wildlife  WildlifeTurnover[]     @relation("ProcessedByStaff")
  env_requests        EnvironmentalRequest[] @relation("UserRequests")
  processed_requests  EnvironmentalRequest[] @relation("ProcessedRequests")
  audit_logs           AuditLog[]
  notifications        Notification[]
  password_reset_tokens PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]
  push_tokens           PushToken[]

  @@index([email])
  @@index([role])
}

// Password reset tokens. We store only the SHA-256 hash of the token, never the
// token itself, so a database leak cannot be used to reset accounts. Tokens are
// single-use (used_at) and time-limited (expires_at).
model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique @db.VarChar(64) // sha256 hex
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
}

// Six-digit email-confirmation codes. Mirrors PasswordResetToken, with two
// deliberate differences: code_hash is NOT unique (a six-digit code has only
// 10^6 values, so two users would eventually collide and a unique constraint
// would reject a legitimate code - lookup is by user_id instead), and the
// target address is stored, so a code mailed to an old address can never
// confirm a new one after the user corrects a typo.
model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  code_hash  String    @db.VarChar(64) // sha256 hex
  email      String    @db.VarChar(255)
  expires_at DateTime
  used_at    DateTime?
  attempts   Int       @default(0)
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
}

// ============================================================
// BARANGAYS (18 barangays of Cabuyao City)
// ============================================================

model Barangay {
  barangay_id      Int     @id @default(autoincrement())
  name             String  @unique @db.VarChar(100)
  latitude         Float?
  longitude        Float?
  geojson_boundary Json? // GeoJSON Feature for the choropleth layer
  // Retired rather than deleted: a barangay with reports against it cannot be
  // removed without orphaning them, and boundaries are derived from the full
  // centroid set (see seed.js), so deleting one reshapes its neighbours.
  is_active        Boolean @default(true)

  users              User[]
  complaints         Complaint[]
  wildlife_turnovers WildlifeTurnover[]
  env_requests       EnvironmentalRequest[]
}

// ============================================================
// ADMIN-MANAGED CATEGORIES
// ============================================================

// Report categories an Admin can add or retire from the UI. Both follow the same
// shape, and both are referenced by NAME (see the note above the status enums).
//
// Rows are never hard-deleted: a category with reports against it must keep
// existing or the history becomes unreadable. is_active hides it from the report
// forms while leaving every existing report intact.
model ComplaintType {
  complaint_type_id Int      @id @default(autoincrement())
  name              String   @unique @db.VarChar(100) // stored on the report
  label             String?  @db.VarChar(120) // display override; humanize(name) otherwise
  is_active         Boolean  @default(true)
  sort_order        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  complaints Complaint[]

  @@index([is_active])
}

model RequestType {
  request_type_id Int      @id @default(autoincrement())
  name            String   @unique @db.VarChar(100)
  label           String?  @db.VarChar(120)
  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)
  // Which SystemSetting holds this type's Citizens Charter budget, and what to
  // use if that row is missing. NULL means the type has no charter SLA and never
  // gets a deadline - which is true of Garbage_Hauling, Creek_River_Cleaning and
  // Other_Service. This replaces the hardcoded REQUEST_SLA_BY_TYPE map, which
  // keyed off literal enum values and would have broken the moment an Admin
  // added a type.
  sla_setting_key      String? @db.VarChar(100)
  sla_fallback_minutes Int?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  requests EnvironmentalRequest[]

  @@index([is_active])
}

// ============================================================
// COMPLAINTS (Environmental Incidents)
// ============================================================

model Complaint {
  complaint_id     Int             @id @default(autoincrement())
  tracking_id      String          @unique @db.VarChar(20) // e.g. CMP-2026-00001
  user_id          Int? // null = anonymous / whistleblower report (no identity captured)
  is_anonymous     Boolean         @default(false)
  // Walk-in intake: a report a resident files in person, logged by staff. The
  // walk-in resident usually has no account, so their name/contact is captured
  // here (null for an anonymous walk-in). logged_by = the staff who recorded it.
  reporter_name    String?         @db.VarChar(1000) // encrypted at rest
  reporter_contact String?         @db.VarChar(1000) // encrypted at rest
  logged_by        Int?
  barangay_id      Int
  assigned_to      Int? // CENRO Staff user_id
  complaint_type   String          @db.VarChar(100) // FK -> ComplaintType.name
  description      String          @db.Text
  photo_path       String?         @db.VarChar(500) // GCS object path
  latitude         Float?
  longitude        Float?
  address_details  String?         @db.VarChar(2000) // encrypted at rest
  status           ComplaintStatus @default(Pending)
  priority         Boolean         @default(false)
  staff_notes      String?         @db.Text
  resolution_notes String?         @db.Text
  submitted_at     DateTime        @default(now()) // filing date/time (auto)
  observed_at      DateTime? // optional: when the resident says they saw the issue
  updated_at       DateTime        @updatedAt
  resolved_at      DateTime?

  // Citizens Charter workflow / SLA tracking (Part 20.1)
  received_via         ComplaintReceivedVia?
  is_highly_technical  Boolean               @default(false)
  inspection_date      DateTime?
  report_prepared_at   DateTime?
  conference_date      DateTime?
  commitment_signed_at DateTime?
  monitoring_date      DateTime?
  // Null until the complaint is Approved: no acknowledgement, no commitment.
  sla_started_at       DateTime?
  sla_deadline         DateTime? // sla_started_at + budget in WORKING minutes
  exceeded_sla         Boolean               @default(false)
  assigned_staff_role  CenroPersonRole?

  // Admin archive (soft delete). Archived rows stay in the database so the
  // status history and audit trail remain intact, but drop out of queues,
  // analytics, public endpoints, and the resident's own list.
  archived_at    DateTime?
  archived_by    Int?
  archive_reason String?   @db.VarChar(255)

  user           User?                    @relation("UserComplaints", fields: [user_id], references: [user_id])
  barangay       Barangay                 @relation(fields: [barangay_id], references: [barangay_id])
  // FK to the admin-managed category table. onUpdate: Cascade so renaming a
  // category rewrites its reports instead of failing; onDelete: Restrict so a
  // category with history cannot be removed out from under them.
  type           ComplaintType            @relation(fields: [complaint_type], references: [name], onUpdate: Cascade, onDelete: Restrict)
  assigned_staff User?                    @relation("AssignedStaff", fields: [assigned_to], references: [user_id])
  logged_by_staff User?                   @relation("LoggedByStaff", fields: [logged_by], references: [user_id])
  status_history ComplaintStatusHistory[]

  @@index([tracking_id])
  @@index([status])
  @@index([barangay_id])
  @@index([user_id])
  @@index([archived_at])
}

model ComplaintStatusHistory {
  id           Int             @id @default(autoincrement())
  complaint_id Int
  old_status   ComplaintStatus
  new_status   ComplaintStatus
  changed_by   Int
  note         String?         @db.Text
  changed_at   DateTime        @default(now())

  complaint Complaint @relation(fields: [complaint_id], references: [complaint_id])

  @@index([complaint_id])
}

// ============================================================
// WILDLIFE TURNOVERS
// ============================================================

model WildlifeTurnover {
  turnover_id             Int             @id @default(autoincrement())
  reference_id            String          @unique @db.VarChar(20) // e.g. WLD-2026-00001
  reported_by             Int // Resident user_id
  processed_by            Int? // CENRO Staff user_id
  barangay_id             Int
  species_name            String          @db.VarChar(200)
  species_category        String?         @db.VarChar(100)
  is_endangered           Boolean         @default(false)
  is_priority_review      Boolean         @default(false)
  animal_condition        AnimalCondition
  description             String          @db.Text
  photo_path              String?         @db.VarChar(500)
  chain_of_custody_photos Json? // array of GCS paths
  latitude                Float?
  longitude               Float?
  address_details         String?         @db.VarChar(2000) // encrypted at rest
  status                  WildlifeStatus  @default(Pending_Review)
  intake_date             DateTime?
  release_date            DateTime?
  transfer_destination    String?         @db.VarChar(255)
  staff_notes             String?         @db.Text
  submitted_at            DateTime        @default(now())
  updated_at              DateTime        @updatedAt

  // Citizens Charter workflow / SLA tracking (Part 20.3)
  reported_via              WildlifeReportedVia?
  wildlife_info_form_filled Boolean              @default(false)
  vet_clearance_secured     Boolean              @default(false)
  vet_clearance_date        DateTime?
  rescue_date               DateTime?
  transport_date            DateTime?
  rescue_report_prepared    Boolean              @default(false)
  rescue_report_date        DateTime?
  // Wildlife stays submission-based: a rescued animal's clock starts when it is
  // reported, not when staff get to it. Recorded anyway so all three models
  // carry one uniform anchor column.
  sla_started_at            DateTime?
  sla_deadline              DateTime? // sla_started_at + budget in WORKING minutes
  exceeded_sla              Boolean              @default(false)
  assigned_staff_role       CenroPersonRole?

  // Admin archive (soft delete) - see the note on Complaint.
  archived_at    DateTime?
  archived_by    Int?
  archive_reason String?   @db.VarChar(255)

  resident User     @relation("UserWildlife", fields: [reported_by], references: [user_id])
  staff    User?    @relation("ProcessedByStaff", fields: [processed_by], references: [user_id])
  barangay Barangay @relation(fields: [barangay_id], references: [barangay_id])
  status_history WildlifeStatusHistory[]

  @@index([reference_id])
  @@index([barangay_id])
  @@index([species_name])
  @@index([status])
  @@index([archived_at])
}

// ============================================================
// ENVIRONMENTAL REQUESTS
// ============================================================

model EnvironmentalRequest {
  request_id         Int           @id @default(autoincrement())
  tracking_id        String        @unique @db.VarChar(20) // e.g. REQ-2026-00001
  user_id            Int
  barangay_id        Int
  processed_by       Int?
  request_type       String        @db.VarChar(100) // FK -> RequestType.name
  description        String        @db.Text
  document_path      String?       @db.VarChar(500)
  requested_quantity Int?
  preferred_schedule DateTime?
  status             RequestStatus @default(Pending)
  scheduled_date     DateTime?
  completion_date    DateTime?
  staff_notes        String?       @db.Text
  submitted_at       DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  // Citizens Charter SLA tracking (Part 20.2)
  // Null until Approved. Mirrors approval_date but kept separate on purpose:
  // that is the CENRO Head's decision record, this is the clock anchor.
  sla_started_at         DateTime?
  sla_deadline           DateTime? // per request_type, in WORKING minutes
  exceeded_sla           Boolean   @default(false)
  approved_by_cenro_head Boolean   @default(false)
  approval_date          DateTime?

  // Admin archive (soft delete) - see the note on Complaint.
  archived_at    DateTime?
  archived_by    Int?
  archive_reason String?   @db.VarChar(255)

  user      User     @relation("UserRequests", fields: [user_id], references: [user_id])
  barangay  Barangay @relation(fields: [barangay_id], references: [barangay_id])
  processor User?    @relation("ProcessedRequests", fields: [processed_by], references: [user_id])
  type      RequestType @relation(fields: [request_type], references: [name], onUpdate: Cascade, onDelete: Restrict)
  status_history RequestStatusHistory[]

  @@index([tracking_id])
  @@index([status])
  @@index([barangay_id])
  @@index([user_id])
  @@index([archived_at])
}

// Status-change timeline for wildlife turnovers (mirrors ComplaintStatusHistory).
model WildlifeStatusHistory {
  id          Int            @id @default(autoincrement())
  turnover_id Int
  old_status  WildlifeStatus
  new_status  WildlifeStatus
  changed_by  Int
  note        String?        @db.Text
  changed_at  DateTime       @default(now())

  turnover WildlifeTurnover @relation(fields: [turnover_id], references: [turnover_id])

  @@index([turnover_id])
}

// Status-change timeline for environmental requests.
model RequestStatusHistory {
  id         Int           @id @default(autoincrement())
  request_id Int
  old_status RequestStatus
  new_status RequestStatus
  changed_by Int
  note       String?       @db.Text
  changed_at DateTime      @default(now())

  request EnvironmentalRequest @relation(fields: [request_id], references: [request_id])

  @@index([request_id])
}

// ============================================================
// AUDIT LOGS / SYSTEM REPORTS
// ============================================================

model AuditLog {
  log_id              Int      @id @default(autoincrement())
  performed_by        Int? // nullable: system-generated actions
  action              String   @db.VarChar(200)
  target_table        String   @db.VarChar(100)
  target_id           Int?
  data_generated_json Json
  ip_address          String?  @db.VarChar(50)
  performed_at        DateTime @default(now())

  user User? @relation(fields: [performed_by], references: [user_id])

  @@index([performed_by])
  @@index([action])
  @@index([performed_at])
}

// ============================================================
// IN-APP NOTIFICATIONS
// ============================================================

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  type            String   @db.VarChar(50) // e.g. STATUS_UPDATE
  title           String   @db.VarChar(200)
  body            String   @db.Text
  link            String?  @db.VarChar(255) // in-app route, e.g. /resident/track/CMP-2026-00001
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id, is_read])
  @@index([created_at])
}

// A device that has agreed to receive push notifications. One row per DEVICE,
// not per user: a resident with a phone and a tablet gets both, and the same
// device signing in as somebody else must not inherit the previous person's
// notifications - which is why `token` is unique and the row is re-pointed at
// whoever registers it, rather than duplicated.
//
// Rows are deleted, never soft-deleted: on sign-out, and whenever Expo answers
// DeviceNotRegistered for a token it no longer recognises. A push token is not
// history worth keeping, and a stale one is a message delivered to the wrong
// phone.
model PushToken {
  push_token_id Int      @id @default(autoincrement())
  user_id       Int
  // The ExpoPushToken, e.g. ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx].
  token         String   @unique @db.VarChar(255)
  platform      String?  @db.VarChar(20) // android | ios
  created_at    DateTime @default(now())
  last_used_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

// ============================================================
// SYSTEM SETTINGS (Admin-configurable)
// ============================================================

model SystemSetting {
  setting_id    Int      @id @default(autoincrement())
  setting_key   String   @unique @db.VarChar(100)
  setting_value String   @db.Text
  description   String?  @db.VarChar(255)
  updated_at    DateTime @updatedAt
}
