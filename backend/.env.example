# ── Database ───────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_MYSQL_ROOT_PASSWORD@localhost:3306/cenrowatch_db"

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────
PORT=5000
CLIENT_URL="http://localhost:5173"
MOBILE_URL="exp://127.0.0.1:19000"

# ── Email (Nodemailer via Gmail) ───────────────────────────
EMAIL_USER="your.cenrowatch.email@gmail.com"
EMAIL_PASS="your_gmail_app_password"
EMAIL_FROM="CENROWATCH <your.cenrowatch.email@gmail.com>"

# ── Google Cloud Storage ───────────────────────────────────
GCS_BUCKET_NAME="cenrowatch-uploads"
GCS_KEY_FILE="./gcs-key.json"

# ── App Config ─────────────────────────────────────────────
APP_NAME="CENROWATCH"
CITY="Cabuyao City"
OFFICE="CENRO Cabuyao"
