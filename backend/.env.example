# ── Database ───────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_MYSQL_ROOT_PASSWORD@localhost:3306/cenrowatch_db"

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────
PORT=5000
CLIENT_URL="http://localhost:5173"
MOBILE_URL="exp://127.0.0.1:19000"

# ── Rate limiting / proxy (DDoS & brute-force mitigation) ──
# Number of reverse-proxy hops in front of the app (e.g. 1 behind nginx). Leave
# blank for direct/local runs. Do NOT set to "true" — that lets clients spoof
# X-Forwarded-For and bypass the per-IP rate limits.
TRUST_PROXY=""
# Global API cap: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Login + register, per 15 min per IP. Counts FAILED attempts only, so a shared
# connection (barangay hall, school, household) is not punished for the volume
# of people signing in correctly behind it -- only for wrong passwords.
AUTH_RATE_LIMIT_MAX=30
# forgot-password + reset-password, per 15 min per IP. Counts every request,
# successful or not: each one sends mail or spends a single-use token.
RESET_RATE_LIMIT_MAX=10
# /uploads, per 15 min per IP. That route sits OUTSIDE /api/v1 (the URL shape is
# stored in photo_path), so RATE_LIMIT_MAX does not cover it. Generous, because
# one report detail page can pull several photos.
FILE_RATE_LIMIT_MAX=600

# ── Encryption at rest (AES-256-GCM) ───────────────────────
# Encrypts the personal fields that are displayed but never searched: contact
# numbers, walk-in reporter names/contacts, and street addresses. Required in
# production; without it in development the app still runs but stores those
# fields in PLAINTEXT and says so on every boot.
#
# 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# BACK THIS UP SOMEWHERE OTHER THAN THIS MACHINE. There is no recovery: lose the
# key and every value encrypted with it is gone for good. Changing it does not
# re-encrypt anything either — rows written under the old key stop being
# readable and the app will say so loudly rather than show you nonsense.
FIELD_ENCRYPTION_KEY=""

# ── Signed upload links ────────────────────────────────────
# How long a /uploads link stays valid, in minutes. Matches the GCS driver's
# 1-hour signed-URL TTL. Uploaded files are no longer served to anyone who has
# the path: each link is signed for one file and expires.
FILE_URL_TTL_MINUTES=60
# Optional. By default the signing key is derived from JWT_SECRET via HMAC,
# which keeps file links and session tokens cryptographically separate without a
# second secret to manage. Set this only if you want an independent one.
FILE_URL_SECRET=""

# ── Email (Nodemailer via Gmail) ───────────────────────────
EMAIL_USER="your.cenrowatch.email@gmail.com"
EMAIL_PASS="your_gmail_app_password"
EMAIL_FROM="CENROWATCH <your.cenrowatch.email@gmail.com>"

# ── File storage ───────────────────────────────────────────
# Where uploads go: "local" (disk, default - for dev) or "gcs" (Google Cloud Storage).
STORAGE_DRIVER="local"
# Required only when STORAGE_DRIVER=gcs:
GCS_BUCKET_NAME="cenrowatch-uploads"
GCS_PROJECT_ID="your-gcp-project-id"
# Provide credentials with EXACTLY ONE of the following:
#   GCS_KEY_FILE         - path to a service-account key file (handy for local smoke tests)
#   GCS_CREDENTIALS_JSON - the key file's JSON inline (use on cloud hosts that can't store a file)
GCS_KEY_FILE="./gcs-key.json"
GCS_CREDENTIALS_JSON=""

# ── App Config ─────────────────────────────────────────────
APP_NAME="CENROWATCH"
CITY="Cabuyao City"
OFFICE="CENRO Cabuyao"

# ── Admin bootstrap (used only by `npm run create-admin`) ──
# Public registration only creates Residents. Use this script to create the
# first Admin (NEW_USER_ROLE = Admin | CENRO_Staff). Safe to leave blank.
NEW_USER_EMAIL=""
NEW_USER_PASSWORD=""
NEW_USER_ROLE="Admin"
NEW_USER_FIRST="System"
NEW_USER_LAST="Administrator"
