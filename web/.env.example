# Where the API lives.
#
# LEAVE THIS UNSET IN PRODUCTION unless you are serving the web app and the API
# from different origins. Unset, a production build uses the relative "/api/v1",
# which is what you want: the session is an HttpOnly SameSite=Lax cookie, so the
# app and the API have to be same-site and are served from one origin behind a
# proxy. Every .env file here is gitignored, so a deployment that DEPENDS on this
# variable being set is a deployment that breaks the first time someone clones
# the repo fresh.
#
# In dev it is unset too and falls back to http://localhost:5000/api/v1. Set it
# to "/api/v1" locally to route through the Vite proxy instead, which puts the
# whole app on one port and makes the cookie behave exactly as it will in
# production (see the proxy block in vite.config.js).
VITE_API_URL=""

# MapTiler Cloud key for the map tiles. Requested by the BROWSER, not the API,
# so it is public by nature; the protection is the allowed-origin list on the
# key itself. Add your production domain there or every map renders blank.
VITE_MAPTILER_API_KEY="your_maptiler_api_key"

VITE_APP_NAME="CENROWATCH"
