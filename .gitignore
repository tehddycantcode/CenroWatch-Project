# Dependencies
node_modules/
**/node_modules/

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
gcs-key.json
**/gcs-key.json

# Uploaded files (local-disk storage stub) — keep the folder, ignore contents
backend/uploads/*
!backend/uploads/.gitkeep

# Build output
dist/
build/
**/dist/
**/build/

# Vite
web/.vite/

# Expo / React Native
mobile/.expo/
mobile/.expo-shared/
*.jks
*.p12
*.key
*.mobileprovision
*.orig.*

# Prisma generated client (regenerated via prisma generate)
**/generated/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Test tooling scratch output. The Playwright MCP browser writes a page snapshot
# and a console log per navigation, so this fills up fast and belongs to a run,
# not to the repo.
.playwright-mcp/
